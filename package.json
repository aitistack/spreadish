{
    "name": "spreadish",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.2",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "dev": "bun run --filter @spreadish/docs dev",
        "docs:dev": "bun run --filter @spreadish/docs dev",
        "docs:build": "bun run --filter @spreadish/docs build",
        "docs:preview": "bun run --filter @spreadish/docs preview",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test:unit": "bun test packages apps/playground/src scripts",
        "test:coverage": "bun test --coverage packages",
        "test:e2e": "playwright test",
        "e2e:install": "playwright install --with-deps",
        "build": "bun run build:packages",
        "build:packages": "bun run --filter \"./packages/*\" build",
        "build:playground": "bun run --filter @spreadish/playground build",
        "build:docs": "bun run --filter @spreadish/docs build",
        "check:circular": "madge --circular --extensions ts,tsx packages",
        "package:check": "bun run scripts/package-check.ts",
        "package:smoke": "bun run scripts/package-smoke.ts",
        "package:registry-smoke": "bun run scripts/package-registry-smoke.ts",
        "package:publish": "bun run scripts/npm-publish.ts",
        "benchmark": "bun run scripts/benchmark.ts",
        "bundle:report": "bun run scripts/bundle-report.ts",
        "audit:deps": "bun run scripts/dependency-audit.ts",
        "version-packages": "changeset version",
        "changeset": "changeset"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.7",
        "@eslint/js": "^9.36.0",
        "@mdx-js/react": "^3.1.1",
        "@mdx-js/rollup": "^3.1.1",
        "@playwright/test": "^1.55.1",
        "@types/bun": "^1.2.22",
        "@types/mdx": "^2.0.14",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "eslint": "^9.36.0",
        "globals": "^16.4.0",
        "madge": "^8.0.0",
        "prettier": "^3.6.2",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "sharp": "^0.35.4",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.44.0",
        "vite": "^8.3.0"
    }
}
