{
    "name": "@spreadish/formula-engine",
    "version": "0.1.0",
    "description": "Lexer, parser, AST, and evaluator for Spreadish formulas (no eval).",
    "license": "MIT",
    "author": "Spreadish contributors",
    "homepage": "https://spreadish.aitistack.com/docs/api/formula-engine",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aitistack/spreadish.git",
        "directory": "packages/formula-engine"
    },
    "bugs": {
        "url": "https://github.com/aitistack/spreadish/issues"
    },
    "keywords": [
        "spreadsheet",
        "spreadish",
        "formula",
        "parser"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "prepack": "bun run build"
    }
}
