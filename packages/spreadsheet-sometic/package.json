{
    "name": "@spreadish/sometic",
    "version": "0.0.0",
    "description": "Official Sometic persistence and multi-workbook workspace adapters for Spreadish.",
    "license": "MIT",
    "author": "Spreadish contributors",
    "homepage": "https://spreadish.aitistack.com/docs/api/sometic",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aitistack/spreadish.git",
        "directory": "packages/spreadsheet-sometic"
    },
    "bugs": {
        "url": "https://github.com/aitistack/spreadish/issues"
    },
    "keywords": [
        "spreadsheet",
        "spreadish",
        "sometic",
        "persistence",
        "indexeddb"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "prepack": "bun run build"
    },
    "peerDependencies": {
        "@sometic/core": "^1.0.7",
        "@sometic/query": "^3.0.3",
        "@sometic/store": "^1.1.3"
    },
    "dependencies": {
        "@spreadish/core": "workspace:*",
        "@sometic/core": "^1.0.7",
        "@sometic/http": "3.0.3",
        "@sometic/query": "^3.0.3",
        "@sometic/store": "^1.1.3"
    }
}
